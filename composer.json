{
    "name": "jovian/venusian-pluto",
    "description": "PlutoVG rasterization driver for Venusian Topside: path coverage through ext-plutovg.",
    "version": "0.11.0",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "topside",
        "rasterization",
        "rasterizer",
        "plutovg"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-pluto/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-pluto/issues",
        "source": "https://github.com/jovian-packages/venusian-pluto"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-plutovg": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Rendering\\Pluto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Rendering\\Pluto\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Rendering\\Pluto\\Providers\\VenusianPlutoServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
